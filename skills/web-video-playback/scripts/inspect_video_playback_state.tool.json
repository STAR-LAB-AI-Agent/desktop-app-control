{
  "protocol": "agent-skill-script/v1",
  "name": "inspect_video_playback_state",
  "description": "间隔截取两张屏幕，判断目标网页视频处于搜索结果、加载、暂停、播放、受阻或不可见状态",
  "entrypoint": "inspect_video_playback_state.py",
  "timeout_seconds": 120,
  "parameters": {
    "type": "object",
    "properties": {
      "video_query": {
        "type": "string",
        "description": "当前任务要播放的视频名称或搜索词"
      },
      "sample_seconds": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 5,
        "description": "两次截图之间的等待秒数，默认 1.5"
      }
    },
    "required": ["video_query"],
    "additionalProperties": false
  }
}
